{{!
    @template mod_waypoint/view

    Mount point for the Waypoint React app.

    The markup inside the react helper section is a read-only fallback. React
    replaces it when it mounts, so a reader with no JavaScript still sees the
    list and their progress — they just cannot tick anything. Keep it in step
    with Waypoint.tsx if the rendered output changes.

    Careful: a Mustache comment ends at the FIRST closing double brace, so a
    tag written out inside this docblock would terminate it early and dump the
    rest of the text onto the page. Never write one here.

    Example context (json):
    {
        "reactprops": "{\"activityId\": 42, \"initialActivity\": { ... }, \"initialItems\": { ... } }",
        "hasitems": true,
        "items": [{"id": 1, "title": "Read the brief", "sortOrder": 1, "done": true}],
        "countlabel": "1 of 1",
        "percentage": 100
    }
}}
{{#react}}
{
    "component": "@moodle/lms/mod_waypoint/Waypoint",
    "class": "mod-waypoint",
    "props": {{{reactprops}}}
}
<div class="mod-waypoint-fallback">
    <p class="fw-bold mb-1">{{#str}}progresstitle, mod_waypoint{{/str}} &mdash; {{countlabel}}</p>
    <div class="progress mb-3" role="progressbar" aria-valuenow="{{percentage}}" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: {{percentage}}%"></div>
    </div>
    {{#hasitems}}
        <ul class="list-unstyled">
            {{#items}}
                <li class="mb-2">
                    <input type="checkbox" class="form-check-input me-2" disabled {{#done}}checked{{/done}}>
                    {{title}}
                </li>
            {{/items}}
        </ul>
    {{/hasitems}}
    {{^hasitems}}
        <p class="text-muted">{{#str}}nowaypoints, mod_waypoint{{/str}}</p>
    {{/hasitems}}
</div>
{{/react}}
