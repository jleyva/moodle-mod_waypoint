{{!
    @template mod_waypoint/report

    Teacher view of everyone's progress. Plain server-rendered markup: the
    table is read once and never mutated, so there is nothing for React to do.

    Example context (json):
    {
        "hasrows": true,
        "rows": [
            {"fullname": "Ada Lovelace", "countlabel": "3 of 4", "percentage": 75, "complete": false}
        ]
    }
}}
{{#hasrows}}
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">{{#str}}fullname, core{{/str}}</th>
                <th scope="col">{{#str}}progresstitle, mod_waypoint{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    <td>{{fullname}}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="min-width: 8rem;"{{!
                                }} role="progressbar"{{!
                                }} aria-label="{{fullname}}"{{!
                                }} aria-valuenow="{{percentage}}"{{!
                                }} aria-valuemin="0"{{!
                                }} aria-valuemax="100">
                                <div class="progress-bar{{#complete}} bg-success{{/complete}}" style="width: {{percentage}}%"></div>
                            </div>
                            <span class="text-nowrap small">{{countlabel}}</span>
                        </div>
                    </td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
{{/hasrows}}
{{^hasrows}}
    <p class="text-muted">{{#str}}nostudents, mod_waypoint{{/str}}</p>
{{/hasrows}}
